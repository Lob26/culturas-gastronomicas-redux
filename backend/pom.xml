<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.uniandes</groupId>
    <artifactId>culturas-backend</artifactId>
    <version>1.0.0</version>
    <name>culturas-backend</name>
    <description>API de Culturas Gastronomicas</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Sólo se declaran versiones de lo que el BOM de Spring Boot 4.1 NO
          gestiona. El BOM ya fija flyway 12.4.0, hibernate 7.4.1, postgresql
          42.7.11, lombok 1.18.46, jackson 3.1.4 y testcontainers 2.0.5:
          repetirlas aquí sólo crea la posibilidad de que se desincronicen.
        -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>3.0.3</springdoc.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <anthropic.version>2.52.0</anthropic.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ============================================================ web -->
        <!--
          `-webmvc`, no `-web`: en Boot 4 el starter clásico quedó deprecado
          como alias del modular.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- =========================================================== datos -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
          Obligatorio en Boot 4: con sólo flyway-core en el classpath la
          autoconfiguración modular NO se activa y las migraciones no corren,
          en silencio y sin ningún aviso.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Desde Flyway 10 el soporte por motor vive en módulos aparte. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ====================================================== seguridad -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
          Da NimbusJwtEncoder/NimbusJwtDecoder para firmar y validar los JWT, y
          además el DSL oauth2ResourceServer con JwtAuthenticationConverter. El
          módulo -jose por sí solo trae únicamente los codificadores: las clases
          de servidor de recursos viven en este starter.

          Ojo al nombre: en Boot 4 los starters de OAuth2 llevan prefijo
          `security-` (spring-boot-starter-security-oauth2-resource-server), no
          el `spring-boot-starter-oauth2-resource-server` de Boot 3.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ======================================================= operación -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ========================================================== mapeo -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ======================================================== openapi -->
        <!--
          springdoc 3.0.3 sigue compilado contra Jackson 2 mientras Boot 4 usa
          Jackson 3, así que conviven los dos en el classpath. Funciona, pero
          por eso la configuración de springdoc en este proyecto es
          exclusivamente por anotaciones: cualquier ModelConverter o
          OpenApiCustomizer programático obligaría a mezclar los dos Jackson.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============================================== embeddings (Fase 4) -->
        <!--
          Da un bean EmbeddingModel respaldado por ONNX Runtime, en proceso: no
          hay servicio que levantar, ni clave que gestionar, ni llamada de red
          por consulta. El modelo se descarga una vez y queda en caché local.

          NO se declara spring-ai-starter-vector-store-pgvector, y es a
          propósito. PgVectorStore crea su propia tabla `vector_store` con una
          COPIA del contenido y sus metadatos en jsonb. Eso significa dos
          fuentes de verdad para el mismo texto y un problema de consistencia
          en cada escritura: editar una receta deja el documento indexado
          mintiendo hasta que algo lo reindexe. Aquí la columna `embedding`
          vive en las tablas del dominio, así que el KNN une directamente con
          la entidad, no hay contenido duplicado y borrar una receta se lleva
          su vector por FK. Ver docs/adr/0003-embeddings-en-el-dominio.md.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-transformers</artifactId>
        </dependency>

        <!-- ============================================== asistente (Fase 5) -->
        <!--
          SDK oficial de Anthropic. Se usa directamente y no a través de la
          abstracción ChatModel de Spring AI porque aquí sólo hay un proveedor y
          no se prevé cambiarlo: la abstracción costaría una capa a cambio de
          una portabilidad que nadie va a ejercer. Además da acceso sin
          traducciones al streaming, que es lo que alimenta el SSE.
        -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic.version}</version>
        </dependency>

        <!-- ========================================================== tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Testcontainers 2.0 renombró todos sus módulos con prefijo
          `testcontainers-`: los coordinates de la era 1.x
          (org.testcontainers:postgresql) ya no existen.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <!--
                          El orden importa: Lombok debe generar los accessors
                          antes de que MapStruct inspeccione los tipos, y el
                          binding es lo que sincroniza a los dos. Sin él,
                          MapStruct no ve los getters de Lombok y genera
                          mappers vacíos sin fallar la compilación.
                        -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                        <!-- Falla la compilación si un campo del destino queda sin mapear. -->
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Los tests de integración (*IT) corren en `verify`, no en `test`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
