# ARCHIVO GENERADO POR TERRAFORM - NO EDITAR A MANO
#
# Se regenera en cada `terraform apply`. Cualquier cambio manual se pierde.
# Para cambiar un valor, edita infra/variables.tf o infra/secrets.tf.
#
# Está en .gitignore: contiene secretos generados.

# --- Postgres ---
POSTGRES_HOST=${postgres_host}
POSTGRES_PORT=${postgres_port}
POSTGRES_DB=${postgres_db}
POSTGRES_USER=${postgres_user}
POSTGRES_PASSWORD=${postgres_password}

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=${redis_port}

# --- MinIO ---
MINIO_HOST=127.0.0.1
MINIO_PORT=${minio_port}
MINIO_ROOT_USER=${minio_user}
MINIO_ROOT_PASSWORD=${minio_password}
MINIO_BUCKET=${minio_bucket}

# --- n8n ---
N8N_PORT=${n8n_port}

# --- Aplicación ---
JWT_SECRET=${jwt_secret}
CULTURAS_API_KEY=${api_key}

# --- Claude (Fase 5) ---
# No lo gestiona Terraform: es una credencial externa. Sin ella el endpoint de
# preguntas en lenguaje natural responde 503 y el resto de la app funciona igual.
ANTHROPIC_API_KEY=
