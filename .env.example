# Copiar a .env y ajustar. .env está en .gitignore.
# Los valores de abajo son los de desarrollo local y NO sirven para producción.

# --- Postgres ---
POSTGRES_DB=culturas
POSTGRES_USER=culturas
POSTGRES_PASSWORD=culturas
# 55432 y no 5432: esta máquina ya tiene otro Postgres en 5432.
POSTGRES_PORT=55432
N8N_DB=n8n

# --- Redis ---
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=culturas-media

# --- n8n ---
N8N_PORT=5678

# --- Aplicación ---
# Clave usada por n8n y por scripts para escribir vía X-API-Key.
# Las peticiones del navegador usan JWT, no esta clave.
CULTURAS_API_KEY=dev-api-key-change-me

# Secreto HMAC para firmar los JWT. En desarrollo puede ser cualquier cosa de
# 32+ bytes; si falta, la aplicación genera uno aleatorio al arrancar y todas
# las sesiones se invalidan en cada reinicio.
JWT_SECRET=dev-only-secret-replace-with-32-bytes-minimum

# --- Claude (Fase 5, preguntas en lenguaje natural) ---
# Sin esta clave el endpoint de RAG responde 503 y el resto de la app funciona igual.
ANTHROPIC_API_KEY=
