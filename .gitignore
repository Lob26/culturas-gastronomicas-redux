# --- Java / Maven ---
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!**/maven-wrapper.jar
hs_err_pid*.log
replay_pid*.log

# --- Node / Angular ---
node_modules/
dist/
.angular/
*.tsbuildinfo
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# El spec descargado es un artefacto intermedio de `task gen:client`.
# El cliente generado en src/api SÍ se versiona: es lo que permite que CI
# detecte deriva entre backend y frontend con un simple git diff.
frontend/openapi.json

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl SÍ se versiona: fija los hashes de los proveedores para
# que todo el mundo resuelva exactamente las mismas versiones.

# --- Secretos y entorno ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Modelos de embeddings ---
# TransformersEmbeddingModel descarga el modelo ONNX (~120-400 MB) en el primer
# arranque y lo cachea. Es un artefacto reproducible, no fuente.
.model-cache/
*.onnx

# --- Datos locales ---
data/
*.db
*.sqlite

# --- IDE / SO ---
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Basura de Podman en Windows ---
# `podman machine ssh` invoca a ssh con -o UserKnownHostsFile=NUL, contando con
# que NUL sea el dispositivo nulo de Windows. Bajo un shell POSIX —Git Bash, o
# el shell embebido con el que Task ejecuta los comandos— NUL es un nombre de
# archivo relativo cualquiera, así que ssh escribe ahí la clave del anfitrión y
# deja un archivo en la raíz del repositorio. Lo genera `task up` al detectar la
# puerta de enlace de la VM.
NUL
